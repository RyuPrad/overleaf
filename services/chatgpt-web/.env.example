# Native OpenCode ChatGPT web provider configuration.
# Copy to ~/.local/share/opencode/chatgpt-web/.env (mode 600).
# OpenCode never loads an arbitrary project's .env for this provider.

# Optional path overrides. Defaults honor XDG_DATA_HOME and resolve to:
# ~/.local/share/opencode/chatgpt-web/{session,conversations}.json
# CHATGPT_WEB_DATA_DIR=/absolute/private/directory
# CHATGPT_WEB_SESSION_FILE=/absolute/private/session.json
# CHATGPT_WEB_CONVERSATION_FILE=/absolute/private/conversations.json

# Reliable native backend. The direct backend generally fails ChatGPT's
# browser-only proof/sentinel checks.
BACKEND=playwright

# Shared browser/chat persistence.
PERSIST_CHAT=1
PERSIST_MAX_CHATS=32
PERSIST_STORE=1
LOCAL_TITLE=1
REFRESH_SESSION=1

# Guarded prefix-only live streaming and visible thinking-status events.
LIVE_STREAM=1
STREAM_THINKING=1

# Continue when the picker cannot be verified and report selectionVerified
# false in provider metadata. Set 1 to fail closed.
STRICT_MODEL_SELECTION=0

# Defaults used for aliases/unknown ids. The built-in High/Medium/Instant model
# ids override CHAT_EFFORT for each request.
CHAT_MODEL=GPT-5.6 Sol
CHAT_EFFORT=High

# Adaptive cooldown and rate-limit backoff (milliseconds).
COOLDOWN_MS=5000
COOLDOWN_MIN_MS=2000
COOLDOWN_MAX_MS=30000
RATE_LIMIT_BACKOFF_MS=90000
RATE_LIMIT_MIN_BACKOFF_MS=30000
RATE_LIMIT_MAX_BACKOFF_MS=900000

# Reply budgets. Soft timeout extends only while real generation is active.
REPLY_TIMEOUT_MS=600000
REPLY_HARD_CAP_MS=900000
REPLY_IDLE_GRACE_MS=30000
REPLY_STALL_MS=480000
# Starts only after the first firewall-verified Send and is shared across the
# initial generation plus any correction/recovery attempts. Queue/cooldown and
# browser preparation do not consume this generation budget.
TURN_HARD_CAP_MS=1200000
# Bound browser navigation, raw preflight, model selection, upload, and composer
# setup before each Send. An expired active lease is fenced; after this grace,
# a non-cooperative Playwright callback is detached and its owned browser reaped.
PRE_SUBMIT_TIMEOUT_MS=180000
TURN_ABORT_GRACE_MS=5000
# Once a reply is delivered, both authenticated raw-read paths share this cap.
RAW_POSTCHECK_TIMEOUT_MS=30000

# Compact OpenCode/MCP tool preamble.
TOOL_DESC_MAX=280
TOOL_PREAMBLE_MAX=12000

# Browser diagnostics. DEBUG=1 enables [server] / [pw-dbg] chatter on stderr
# (off by default so native OpenCode TUI is not painted over).
HEADED=0
DEBUG=0

# Reject bash/shell commands longer than this in either accepted call format.
BASH_COMMAND_MAX=4096

# HTTP compatibility runtime only. Native OpenCode does not bind a port and is
# always live when explicitly selected.
HOST=127.0.0.1
PORT=8787
DRY_RUN=1
MAX_BODY_BYTES=2097152
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX=256
